{
  "name": "pdfsy",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 execute pdfsy --local --file=./migrations/0000_init.sql",
    "db:remote": "wrangler d1 execute pdfsy --remote --file=./migrations/0000_init.sql",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client"
  },
  "dependencies": {
    "hono": "^4.13.3",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@tailwindcss/cli": "^4.3.3",
    "alpinejs": "^3.16.2",
    "basecoat-css": "^1.0.2",
    "esbuild": "^0.28.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.125.0"
  }
}
